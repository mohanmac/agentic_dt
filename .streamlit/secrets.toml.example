# Streamlit Cloud secrets template — paste these into the Secrets field
# on share.streamlit.io (App settings → Secrets). Real values must never be
# committed; .streamlit/secrets.toml is gitignored.
#
# Streamlit Cloud injects each key as an environment variable, which
# pydantic-settings (app/core/config.py) reads automatically.

# Kite Connect (Zerodha). Get from https://developers.kite.trade
KITE_API_KEY = "your_api_key_here"
KITE_API_SECRET = "your_api_secret_here"

# After the first deploy, paste the assigned Streamlit URL with the callback
# path here and into the Kite developer console.
KITE_REDIRECT_URL = "https://your-app.streamlit.app/?auth=kite"

# LLM — single shared key used ONLY by agent09_sentiment.
LLM_PROVIDER = "openai"
OPENAI_API_KEY = "sk-..."
OPENAI_MODEL = "gpt-4o-mini"

# Capital tile + sizing only — no real orders unless KITE creds are valid
# AND the Auto-execute toggle is ON in the UI.
DAILY_CAPITAL = "2000"
