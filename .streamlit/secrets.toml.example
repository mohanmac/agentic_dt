# Streamlit Cloud secrets — paste into: Manage app → Settings → Secrets
# Never commit real keys. Copy this file to secrets.toml only for local testing
# (.streamlit/secrets.toml is gitignored).

# Zerodha Kite — https://developers.kite.trade
# Redirect URL here MUST match the Redirect URL in the Kite app settings exactly.
KITE_API_KEY = "your_api_key_here"
KITE_API_SECRET = "your_api_secret_here"
KITE_REDIRECT_URL = "https://proactive-agentic-dt.streamlit.app"

# LLM (Cloud: use openai — Ollama does not run on Streamlit Community Cloud)
LLM_PROVIDER = "openai"
OPENAI_API_KEY = "sk-..."
OPENAI_MODEL = "gpt-4o-mini"

# Session capital display / sizing (string or number both work)
DAILY_CAPITAL = "2000"
MAX_DAILY_LOSS = "200"
MAX_TRADES_PER_DAY = "5"
PER_TRADE_MAX_LOSS_ABSOLUTE = "70"

# Real broker orders stay disabled until this is true AND the dashboard
# Auto-execute acknowledgement/toggle is enabled during 10:15–14:45 IST.
ENABLE_LIVE_TRADING = "false"
FORCE_EXIT_TIME_HOUR = "15"
FORCE_EXIT_TIME_MINUTE = "15"
