# Streamlit Cloud secrets template — paste these into
# App settings → Secrets on share.streamlit.io.
#
# Streamlit Cloud exposes each key as an environment variable, which
# pydantic-settings (app/core/config.py) picks up automatically.
#
# DO NOT commit a real .streamlit/secrets.toml — it is gitignored.

# Kite Connect (Zerodha). Get from https://developers.kite.trade
KITE_API_KEY = "your_api_key_here"
KITE_API_SECRET = "your_api_secret_here"

# After your first deploy, paste the assigned Streamlit Cloud URL here
# with the callback path, and set the SAME value in the Kite developer
# console as your app's Redirect URL.
# (Live login from the cloud also needs the OAuth refactor — see README.)
KITE_REDIRECT_URL = "https://your-app.streamlit.app/?auth=kite"

# LLM — only agent09_sentiment uses this.
# Ollama is not reachable on cloud; use Gemini.
LLM_PROVIDER = "google"
GOOGLE_API_KEY = "your_gemini_api_key_here"

# Capital tile + sizing only — no real orders unless KITE creds are valid
# AND the Auto-execute toggle is ON in the UI.
DAILY_CAPITAL = "2000"
